# Copy to .dev.vars for `wrangler dev` (.dev.vars is gitignored).
# In production set these with `wrangler secret put <NAME>`, never in wrangler.jsonc.
USERNAME = "admin"
PASSWORD = "change-me"
AUTH_SECRET = "run: openssl rand -base64 32"
# 1, true or True adds a fifth group; anything else, or leaving it out, keeps four.
FIVE_GROUPS = "false"
