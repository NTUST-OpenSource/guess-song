{
    "name": "guess-song",
    "account_id": "645a24d2df77eacbbc8a34a4f4938206",
    "main": "src/index.js",
    "compatibility_date": "2025-11-01",
    "routes": [{ "pattern": "song.ntust.org", "custom_domain": true }],
    "assets": {
        "directory": "./public",
        // /api/* 一律交給 Worker，其餘走靜態檔（/login -> public/login.html）
        "run_worker_first": ["/api/*"]
    },
    "durable_objects": {
        "bindings": [{ "name": "SCORES", "class_name": "Scores" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scores"] }],
    "observability": { "enabled": true }
}
