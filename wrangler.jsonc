{
    "name": "guess-song",
    "account_id": "645a24d2df77eacbbc8a34a4f4938206",
    "main": "src/index.js",
    "compatibility_date": "2025-11-01",
    "routes": [{ "pattern": "song.ntust.org", "custom_domain": true }],
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // /api/* goes to the Worker; everything else is a static file (/login -> public/login.html).
        // The icons go through the Worker too, which serves the five-shape ones from /five/ when FIVE_GROUPS is on.
        "run_worker_first": ["/api/*", "/favicon.svg", "/favicon.ico", "/apple-touch-icon.png"]
    },
    "durable_objects": {
        "bindings": [{ "name": "SCORES", "class_name": "Scores" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scores"] }],
    "observability": { "enabled": true }
}
